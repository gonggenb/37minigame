{
  "$defs": {
    "AnimationReview": {
      "additionalProperties": false,
      "properties": {
        "baseline_drift_px": {
          "minimum": 0,
          "title": "Baseline Drift Px",
          "type": "number"
        },
        "center_drift_px": {
          "minimum": 0,
          "title": "Center Drift Px",
          "type": "number"
        },
        "issues": {
          "items": {
            "type": "string"
          },
          "title": "Issues",
          "type": "array"
        },
        "size_drift_ratio": {
          "minimum": 0,
          "title": "Size Drift Ratio",
          "type": "number"
        }
      },
      "required": [
        "center_drift_px",
        "size_drift_ratio",
        "baseline_drift_px"
      ],
      "title": "AnimationReview",
      "type": "object"
    },
    "AssetCategory": {
      "enum": [
        "character",
        "scene",
        "item",
        "animation",
        "effect",
        "ui"
      ],
      "title": "AssetCategory",
      "type": "string"
    },
    "AssetTask": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Asset Id",
          "type": "string"
        },
        "brief": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Brief",
          "type": "string"
        },
        "candidate_count": {
          "default": 4,
          "maximum": 4,
          "minimum": 1,
          "title": "Candidate Count",
          "type": "integer"
        },
        "category": {
          "$ref": "#/$defs/AssetCategory"
        },
        "constraint_overrides": {
          "additionalProperties": true,
          "title": "Constraint Overrides",
          "type": "object"
        },
        "constraint_profile": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Constraint Profile",
          "type": "string"
        },
        "name": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "output_mode": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Output Mode",
          "type": "string"
        },
        "reference_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 4,
          "title": "Reference Ids",
          "type": "array"
        },
        "style_pack": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Style Pack",
          "type": "string"
        },
        "usage": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Usage",
          "type": "string"
        }
      },
      "required": [
        "asset_id",
        "category",
        "name",
        "brief",
        "usage",
        "style_pack",
        "constraint_profile",
        "output_mode"
      ],
      "title": "AssetTask",
      "type": "object"
    },
    "AutoRepairSummary": {
      "additionalProperties": false,
      "properties": {
        "attempts": {
          "items": {
            "$ref": "#/$defs/ReviewAttempt"
          },
          "maxItems": 3,
          "title": "Attempts",
          "type": "array"
        },
        "max_retries": {
          "maximum": 2,
          "minimum": 0,
          "title": "Max Retries",
          "type": "integer"
        },
        "retry_count": {
          "maximum": 2,
          "minimum": 0,
          "title": "Retry Count",
          "type": "integer"
        },
        "stop_reason": {
          "enum": [
            "passed",
            "retry-limit-reached",
            "no-actionable-failure",
            "manual-review-required",
            "disabled"
          ],
          "title": "Stop Reason",
          "type": "string"
        }
      },
      "required": [
        "retry_count",
        "max_retries",
        "stop_reason"
      ],
      "title": "AutoRepairSummary",
      "type": "object"
    },
    "ExportRecord": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "title": "Asset Id",
          "type": "string"
        },
        "category": {
          "$ref": "#/$defs/AssetCategory"
        },
        "file_bytes": {
          "exclusiveMinimum": 0,
          "title": "File Bytes",
          "type": "integer"
        },
        "filename": {
          "title": "Filename",
          "type": "string"
        },
        "hard_constraints": {
          "$ref": "#/$defs/HardConstraintReport"
        },
        "project_id": {
          "title": "Project Id",
          "type": "string"
        },
        "relative_path": {
          "title": "Relative Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "variant": {
          "title": "Variant",
          "type": "string"
        },
        "written_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Written Sha256",
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "asset_id",
        "category",
        "variant",
        "filename",
        "relative_path",
        "sha256",
        "written_sha256",
        "file_bytes",
        "hard_constraints"
      ],
      "title": "ExportRecord",
      "type": "object"
    },
    "GenerationPlan": {
      "additionalProperties": false,
      "properties": {
        "asset_type": {
          "$ref": "#/$defs/AssetCategory"
        },
        "camera": {
          "title": "Camera",
          "type": "string"
        },
        "composition": {
          "title": "Composition",
          "type": "string"
        },
        "identity_constraints": {
          "items": {
            "type": "string"
          },
          "title": "Identity Constraints",
          "type": "array"
        },
        "lighting": {
          "title": "Lighting",
          "type": "string"
        },
        "negative_constraints": {
          "items": {
            "type": "string"
          },
          "title": "Negative Constraints",
          "type": "array"
        },
        "output_spec": {
          "$ref": "#/$defs/ImageOutputSpec"
        },
        "postprocess_steps": {
          "items": {
            "type": "string"
          },
          "title": "Postprocess Steps",
          "type": "array"
        },
        "prompt": {
          "minLength": 1,
          "title": "Prompt",
          "type": "string"
        },
        "quality_checks": {
          "items": {
            "type": "string"
          },
          "title": "Quality Checks",
          "type": "array"
        },
        "repair_strategy": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Repair Strategy",
          "type": "array"
        },
        "selected_reference_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 4,
          "title": "Selected Reference Ids",
          "type": "array"
        },
        "usage": {
          "title": "Usage",
          "type": "string"
        }
      },
      "required": [
        "asset_type",
        "usage",
        "selected_reference_ids",
        "composition",
        "camera",
        "lighting",
        "identity_constraints",
        "prompt",
        "negative_constraints",
        "output_spec",
        "postprocess_steps",
        "quality_checks",
        "repair_strategy"
      ],
      "title": "GenerationPlan",
      "type": "object"
    },
    "HardConstraintCheck": {
      "additionalProperties": false,
      "properties": {
        "message": {
          "default": "",
          "title": "Message",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "passed"
      ],
      "title": "HardConstraintCheck",
      "type": "object"
    },
    "HardConstraintReport": {
      "additionalProperties": false,
      "properties": {
        "checks": {
          "items": {
            "$ref": "#/$defs/HardConstraintCheck"
          },
          "title": "Checks",
          "type": "array"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        }
      },
      "required": [
        "passed",
        "checks"
      ],
      "title": "HardConstraintReport",
      "type": "object"
    },
    "ImageOutputSpec": {
      "additionalProperties": false,
      "properties": {
        "format": {
          "const": "png",
          "default": "png",
          "title": "Format",
          "type": "string"
        },
        "height": {
          "exclusiveMinimum": 0,
          "maximum": 3840,
          "title": "Height",
          "type": "integer"
        },
        "transparent_required": {
          "default": true,
          "title": "Transparent Required",
          "type": "boolean"
        },
        "width": {
          "exclusiveMinimum": 0,
          "maximum": 3840,
          "title": "Width",
          "type": "integer"
        }
      },
      "required": [
        "width",
        "height"
      ],
      "title": "ImageOutputSpec",
      "type": "object"
    },
    "ProcessedImageMetadata": {
      "additionalProperties": false,
      "properties": {
        "alpha_bounds": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "integer"
            },
            {
              "type": "integer"
            },
            {
              "type": "integer"
            },
            {
              "type": "integer"
            }
          ],
          "title": "Alpha Bounds",
          "type": "array"
        },
        "file_bytes": {
          "exclusiveMinimum": 0,
          "title": "File Bytes",
          "type": "integer"
        },
        "height": {
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "integer"
        },
        "mode": {
          "const": "RGBA",
          "default": "RGBA",
          "title": "Mode",
          "type": "string"
        },
        "scale": {
          "exclusiveMinimum": 0,
          "title": "Scale",
          "type": "number"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "source_alpha_bounds": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "integer"
            },
            {
              "type": "integer"
            },
            {
              "type": "integer"
            },
            {
              "type": "integer"
            }
          ],
          "title": "Source Alpha Bounds",
          "type": "array"
        },
        "width": {
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "integer"
        }
      },
      "required": [
        "width",
        "height",
        "source_alpha_bounds",
        "alpha_bounds",
        "scale",
        "sha256",
        "file_bytes"
      ],
      "title": "ProcessedImageMetadata",
      "type": "object"
    },
    "ProductionCandidate": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "pattern": "^candidate-[0-3]$",
          "title": "Candidate Id",
          "type": "string"
        },
        "comparison_relative_path": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Comparison Relative Path"
        },
        "hard_constraints": {
          "$ref": "#/$defs/HardConstraintReport"
        },
        "index": {
          "maximum": 3,
          "minimum": 0,
          "title": "Index",
          "type": "integer"
        },
        "metadata": {
          "$ref": "#/$defs/ProcessedImageMetadata"
        },
        "processed_relative_path": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Processed Relative Path",
          "type": "string"
        },
        "quality_report": {
          "anyOf": [
            {
              "$ref": "#/$defs/QualityReport"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "raw_relative_path": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Raw Relative Path",
          "type": "string"
        },
        "revised_prompt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revised Prompt"
        }
      },
      "required": [
        "candidate_id",
        "index",
        "raw_relative_path",
        "processed_relative_path",
        "metadata",
        "hard_constraints"
      ],
      "title": "ProductionCandidate",
      "type": "object"
    },
    "QualityReport": {
      "additionalProperties": false,
      "properties": {
        "animation_review": {
          "anyOf": [
            {
              "$ref": "#/$defs/AnimationReview"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "decision": {
          "default": "manual_review",
          "enum": [
            "pass",
            "retry",
            "manual_review"
          ],
          "title": "Decision",
          "type": "string"
        },
        "export_allowed": {
          "title": "Export Allowed",
          "type": "boolean"
        },
        "hard_constraints": {
          "$ref": "#/$defs/HardConstraintReport"
        },
        "review_basis": {
          "items": {
            "type": "string"
          },
          "title": "Review Basis",
          "type": "array"
        },
        "style_review": {
          "$ref": "#/$defs/StyleReview"
        }
      },
      "required": [
        "hard_constraints",
        "style_review",
        "export_allowed"
      ],
      "title": "QualityReport",
      "type": "object"
    },
    "RepairPlan": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "none",
            "edit",
            "reprocess",
            "manual"
          ],
          "title": "Action",
          "type": "string"
        },
        "prompt": {
          "default": "",
          "maxLength": 8000,
          "title": "Prompt",
          "type": "string"
        },
        "reason": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "retry_allowed": {
          "default": false,
          "title": "Retry Allowed",
          "type": "boolean"
        },
        "stop_reason": {
          "anyOf": [
            {
              "enum": [
                "passed",
                "retry-limit-reached",
                "no-actionable-failure",
                "manual-review-required",
                "disabled"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stop Reason"
        },
        "target_dimensions": {
          "items": {
            "enum": [
              "hard_constraint",
              "identity",
              "palette",
              "line_style",
              "composition",
              "animation"
            ],
            "type": "string"
          },
          "title": "Target Dimensions",
          "type": "array"
        }
      },
      "required": [
        "action",
        "reason"
      ],
      "title": "RepairPlan",
      "type": "object"
    },
    "ReviewAttempt": {
      "additionalProperties": false,
      "properties": {
        "attempt_index": {
          "maximum": 2,
          "minimum": 0,
          "title": "Attempt Index",
          "type": "integer"
        },
        "candidate_id": {
          "pattern": "^candidate-[0-3]$",
          "title": "Candidate Id",
          "type": "string"
        },
        "comparison_relative_path": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Comparison Relative Path",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "quality_report": {
          "anyOf": [
            {
              "$ref": "#/$defs/QualityReport"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "repair_plan": {
          "anyOf": [
            {
              "$ref": "#/$defs/RepairPlan"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "run_id": {
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Run Id",
          "type": "string"
        }
      },
      "required": [
        "attempt_index",
        "run_id",
        "candidate_id",
        "comparison_relative_path"
      ],
      "title": "ReviewAttempt",
      "type": "object"
    },
    "ReviewFinding": {
      "additionalProperties": false,
      "properties": {
        "actionable": {
          "default": true,
          "title": "Actionable",
          "type": "boolean"
        },
        "dimension": {
          "enum": [
            "hard_constraint",
            "identity",
            "palette",
            "line_style",
            "composition",
            "animation"
          ],
          "title": "Dimension",
          "type": "string"
        },
        "evidence": {
          "maxLength": 1200,
          "minLength": 1,
          "title": "Evidence",
          "type": "string"
        },
        "repair_hint": {
          "default": "",
          "maxLength": 1200,
          "title": "Repair Hint",
          "type": "string"
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "error"
          ],
          "title": "Severity",
          "type": "string"
        },
        "summary": {
          "maxLength": 400,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "dimension",
        "severity",
        "summary",
        "evidence"
      ],
      "title": "ReviewFinding",
      "type": "object"
    },
    "StyleReview": {
      "additionalProperties": false,
      "properties": {
        "composition_score": {
          "maximum": 100,
          "minimum": 0,
          "title": "Composition Score",
          "type": "integer"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/ReviewFinding"
          },
          "title": "Findings",
          "type": "array"
        },
        "identity_score": {
          "maximum": 100,
          "minimum": 0,
          "title": "Identity Score",
          "type": "integer"
        },
        "issues": {
          "items": {
            "type": "string"
          },
          "title": "Issues",
          "type": "array"
        },
        "line_style_score": {
          "maximum": 100,
          "minimum": 0,
          "title": "Line Style Score",
          "type": "integer"
        },
        "palette_score": {
          "maximum": 100,
          "minimum": 0,
          "title": "Palette Score",
          "type": "integer"
        },
        "repair_instruction": {
          "default": "",
          "title": "Repair Instruction",
          "type": "string"
        },
        "risk_notes": {
          "items": {
            "type": "string"
          },
          "title": "Risk Notes",
          "type": "array"
        },
        "score": {
          "maximum": 100,
          "minimum": 0,
          "title": "Score",
          "type": "integer"
        },
        "strengths": {
          "items": {
            "type": "string"
          },
          "title": "Strengths",
          "type": "array"
        },
        "summary": {
          "default": "",
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "score",
        "identity_score",
        "palette_score",
        "line_style_score",
        "composition_score",
        "issues"
      ],
      "title": "StyleReview",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "auto_repair_summary": {
      "anyOf": [
        {
          "$ref": "#/$defs/AutoRepairSummary"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "candidates": {
      "items": {
        "$ref": "#/$defs/ProductionCandidate"
      },
      "maxItems": 4,
      "title": "Candidates",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "edit_instruction": {
      "default": "",
      "title": "Edit Instruction",
      "type": "string"
    },
    "export": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExportRecord"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "plan": {
      "anyOf": [
        {
          "$ref": "#/$defs/GenerationPlan"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "project_id": {
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Project Id",
      "type": "string"
    },
    "prompt": {
      "default": "",
      "title": "Prompt",
      "type": "string"
    },
    "review_attempts": {
      "items": {
        "$ref": "#/$defs/ReviewAttempt"
      },
      "maxItems": 3,
      "title": "Review Attempts",
      "type": "array"
    },
    "run_id": {
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "selected_candidate_id": {
      "anyOf": [
        {
          "pattern": "^candidate-[0-3]$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Selected Candidate Id"
    },
    "source_candidate_id": {
      "anyOf": [
        {
          "pattern": "^candidate-[0-3]$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Candidate Id"
    },
    "source_run_id": {
      "anyOf": [
        {
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Run Id"
    },
    "status": {
      "enum": [
        "planned",
        "generated",
        "selected",
        "reviewed",
        "exported",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "task": {
      "$ref": "#/$defs/AssetTask"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "project_id",
    "task",
    "status"
  ],
  "title": "ProductionRun",
  "type": "object"
}
