{
  "$defs": {
    "AnimationReview": {
      "additionalProperties": false,
      "properties": {
        "baseline_drift_px": {
          "minimum": 0,
          "title": "Baseline Drift Px",
          "type": "number"
        },
        "center_drift_px": {
          "minimum": 0,
          "title": "Center Drift Px",
          "type": "number"
        },
        "issues": {
          "items": {
            "type": "string"
          },
          "title": "Issues",
          "type": "array"
        },
        "size_drift_ratio": {
          "minimum": 0,
          "title": "Size Drift Ratio",
          "type": "number"
        }
      },
      "required": [
        "center_drift_px",
        "size_drift_ratio",
        "baseline_drift_px"
      ],
      "title": "AnimationReview",
      "type": "object"
    },
    "HardConstraintCheck": {
      "additionalProperties": false,
      "properties": {
        "message": {
          "default": "",
          "title": "Message",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "passed"
      ],
      "title": "HardConstraintCheck",
      "type": "object"
    },
    "HardConstraintReport": {
      "additionalProperties": false,
      "properties": {
        "checks": {
          "items": {
            "$ref": "#/$defs/HardConstraintCheck"
          },
          "title": "Checks",
          "type": "array"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        }
      },
      "required": [
        "passed",
        "checks"
      ],
      "title": "HardConstraintReport",
      "type": "object"
    },
    "ReviewFinding": {
      "additionalProperties": false,
      "properties": {
        "actionable": {
          "default": true,
          "title": "Actionable",
          "type": "boolean"
        },
        "dimension": {
          "enum": [
            "hard_constraint",
            "identity",
            "palette",
            "line_style",
            "composition",
            "animation"
          ],
          "title": "Dimension",
          "type": "string"
        },
        "evidence": {
          "maxLength": 1200,
          "minLength": 1,
          "title": "Evidence",
          "type": "string"
        },
        "repair_hint": {
          "default": "",
          "maxLength": 1200,
          "title": "Repair Hint",
          "type": "string"
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "error"
          ],
          "title": "Severity",
          "type": "string"
        },
        "summary": {
          "maxLength": 400,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "dimension",
        "severity",
        "summary",
        "evidence"
      ],
      "title": "ReviewFinding",
      "type": "object"
    },
    "StyleReview": {
      "additionalProperties": false,
      "properties": {
        "composition_score": {
          "maximum": 100,
          "minimum": 0,
          "title": "Composition Score",
          "type": "integer"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/ReviewFinding"
          },
          "title": "Findings",
          "type": "array"
        },
        "identity_score": {
          "maximum": 100,
          "minimum": 0,
          "title": "Identity Score",
          "type": "integer"
        },
        "issues": {
          "items": {
            "type": "string"
          },
          "title": "Issues",
          "type": "array"
        },
        "line_style_score": {
          "maximum": 100,
          "minimum": 0,
          "title": "Line Style Score",
          "type": "integer"
        },
        "palette_score": {
          "maximum": 100,
          "minimum": 0,
          "title": "Palette Score",
          "type": "integer"
        },
        "repair_instruction": {
          "default": "",
          "title": "Repair Instruction",
          "type": "string"
        },
        "risk_notes": {
          "items": {
            "type": "string"
          },
          "title": "Risk Notes",
          "type": "array"
        },
        "score": {
          "maximum": 100,
          "minimum": 0,
          "title": "Score",
          "type": "integer"
        },
        "strengths": {
          "items": {
            "type": "string"
          },
          "title": "Strengths",
          "type": "array"
        },
        "summary": {
          "default": "",
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "score",
        "identity_score",
        "palette_score",
        "line_style_score",
        "composition_score",
        "issues"
      ],
      "title": "StyleReview",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "animation_review": {
      "anyOf": [
        {
          "$ref": "#/$defs/AnimationReview"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "decision": {
      "default": "manual_review",
      "enum": [
        "pass",
        "retry",
        "manual_review"
      ],
      "title": "Decision",
      "type": "string"
    },
    "export_allowed": {
      "title": "Export Allowed",
      "type": "boolean"
    },
    "hard_constraints": {
      "$ref": "#/$defs/HardConstraintReport"
    },
    "review_basis": {
      "items": {
        "type": "string"
      },
      "title": "Review Basis",
      "type": "array"
    },
    "style_review": {
      "$ref": "#/$defs/StyleReview"
    }
  },
  "required": [
    "hard_constraints",
    "style_review",
    "export_allowed"
  ],
  "title": "QualityReport",
  "type": "object"
}
